<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
<ImportGroup Label="PropertySheets" />
<PropertyGroup Label="UserMacros">
<!-- Tool path properties used by .vcxproj CustomBuild commands. - Leave empty to rely on PATH (recommended). - CI can override them via msbuild /p:FlexPath="C:\path\" /p:BisonPath="C:\path\" /p:AsmPath="C:\path\". Example: /p:AsmPath="C:\ProgramData\chocolatey\lib\mingw\tools\install\mingw64\bin\" -->
<FlexPath></FlexPath>
<BisonPath></BisonPath>
<AsmPath></AsmPath>
</PropertyGroup>
<PropertyGroup>
<_PropertySheetDisplayName>BuildToolProperty</_PropertySheetDisplayName>
</PropertyGroup>
<ItemDefinitionGroup />
<ItemGroup>
<BuildMacro Include="FlexPath">
<Value>$(FlexPath)</Value>
</BuildMacro>
<BuildMacro Include="BisonPath">
<Value>$(BisonPath)</Value>
</BuildMacro>
<BuildMacro Include="AsmPath">
<Value>$(AsmPath)</Value>
</BuildMacro>
</ItemGroup>
</Project>

